# LandKrypt Environment Configuration Template
# Copy this file to .env.local and fill in your values

# ====== APPLICATION ======
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ====== DATABASE (Supabase) ======
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ====== BLOCKCHAIN ======
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_prefix
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key
ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/your_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=sepolia

# Gas Settings (optional)
MAX_FEE_PER_GAS=50000000000
MAX_PRIORITY_FEE_PER_GAS=2000000000

# ====== IPFS (Pinata) ======
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ====== CONTRACT ADDRESSES ======
# These will be populated after deployment
NEXT_PUBLIC_LKUSD_ADDRESS=
NEXT_PUBLIC_LKST_ADDRESS=
NEXT_PUBLIC_REAL_ESTATE_NFT_ADDRESS=
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
NEXT_PUBLIC_NFT_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_DEVELOPMENT_CONTRACT_ADDRESS=
NEXT_PUBLIC_STAKING_FACTORY_ADDRESS=
NEXT_PUBLIC_NFT_DAO_ADDRESS=

# ====== SECURITY ======
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
ENCRYPTION_KEY=your_encryption_key_32_characters_long
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ====== WALLET INTEGRATION ======
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ====== MONITORING & ANALYTICS ======
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_GA_ID=your_google_analytics_id
MIXPANEL_TOKEN=your_mixpanel_token

# ====== FEATURE FLAGS ======
ENABLE_STAKING=true
ENABLE_MARKETPLACE=true
ENABLE_DAO=true
ENABLE_TIER_SYSTEM=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# ====== LIMITS & CONFIGURATION ======
MAX_NFTS_PER_USER=100
MAX_FILE_SIZE=10485760
RATE_LIMIT_MAX=100

# ====== CORS CONFIGURATION ======
CORS_ORIGIN=http://localhost:3000

# ====== LOGGING ======
LOG_LEVEL=info
LOG_FORMAT=json

# ====== PRODUCTION SPECIFIC ======
# Uncomment and configure for production deployment
# NODE_ENV=production
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
# NEXT_PUBLIC_CHAIN_ID=1
# NEXT_PUBLIC_NETWORK_NAME=mainnet
# SENTRY_TRACES_SAMPLE_RATE=0.1
