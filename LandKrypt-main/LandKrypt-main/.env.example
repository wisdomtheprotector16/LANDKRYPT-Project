# LandKrypt Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# Last Updated: 2025-06-27

# ===========================================
# REQUIRED FOR DEPLOYMENT
# ===========================================

# Alchemy API Configuration (Required)
# Get from: https://alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Deployment Private Key (Required for contract deployment)
# NEVER commit this to version control!
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_prefix

# Pinata API Keys (Required for NFT minting)
# Get from: https://pinata.cloud/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# ===========================================
# OPTIONAL BUT RECOMMENDED
# ===========================================

# WalletConnect Project ID (Recommended)
# Get from: https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Etherscan API Key (Recommended for contract verification)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key

# ===========================================
# ADVANCED CONFIGURATION
# ===========================================

# Database (Optional - for future features)
DATABASE_URL=postgresql://username:password@localhost:5432/landkrypt

# Supabase (Alternative to PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Security (Optional but recommended for production)
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# NOTES
# ===========================================

# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual keys
# 3. Never commit .env.local to version control
# 4. For production, set NODE_ENV=production
# 5. Contract addresses will be auto-populated after deployment
