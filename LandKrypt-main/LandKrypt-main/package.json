{
  "name": "wtf",
  "version": "0.1.0",
  "private": true,
"scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",

    "deploy:contracts": "hardhat run contracts/scripts/deploy-unified.js",
    "deploy:localhost": "hardhat run contracts/scripts/deploy-unified.js --network localhost",
    "deploy:sepolia": "hardhat run contracts/scripts/deploy-unified.js --network sepolia",
    "deploy:mainnet": "hardhat run contracts/scripts/deploy-unified.js --network mainnet",

    "db:test": "node scripts/database/database-unified.js test",
    "db:setup": "node scripts/database/database-unified.js setup",
    "db:health": "node scripts/database/database-unified.js health",
    "db:stats": "node scripts/database/database-unified.js stats",
    "db:backup": "node scripts/database/database-unified.js backup",
    "db:sync": "node scripts/database/sync-data.js all",

    "nft:mint": "node scripts/metadata/nft-unified.js mint",
    "nft:next-id": "node scripts/metadata/nft-unified.js next-id",
    "nft:metadata": "node scripts/metadata/nft-unified.js metadata",
    "nft:generate": "node tools/generators/nft-generator.js",
    "nft:generate:single": "node tools/generators/nft-generator.js single",
    "nft:generate:batch": "node tools/generators/nft-generator.js batch",
    "nft:generate:collection": "node tools/generators/nft-generator.js collection",
    "nft:templates": "node tools/generators/nft-generator.js templates",
    "nft:locations": "node tools/generators/nft-generator.js locations",
    "nft:rarities": "node tools/generators/nft-generator.js rarities",
    "nft:preview": "node tools/generators/nft-generator.js preview",

    "marketplace:generate": "node scripts/metadata/generateMarketplaceData.js",
    "marketplace:store": "node scripts/database/store-marketplace-listings.js",
    "marketplace:store-all": "node scripts/database/store-marketplace-listings.js --include-unlisted true",

    "env:validate": "node scripts/deployment/validateEnv.js",
    "setup:dev": "npm run env:validate && npm run marketplace:generate",
    "postdeploy": "npm run marketplace:generate",
    "predev": "npm run env:validate",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contracts": "jest tests/contract-integration.test.js",
    "test:e2e": "jest tests/e2e/user-flows.test.js",
    "test:validation": "jest src/utils/__tests__/dataValidation.test.js",
    "test:all": "npm run test:validation && npm run test:contracts && npm run test:e2e",

    "test:upgrades": "npx hardhat test tests/upgrades/*.test.js",
    "test:upgrades:access": "npx hardhat test tests/upgrades/AccessControlUpgrade.test.js",
    "test:upgrades:nft": "npx hardhat test tests/upgrades/GasOptimizedNFT.test.js",
    "test:upgrades:marketplace": "npx hardhat test tests/upgrades/EnhancedMarketplace.test.js",
    "test:upgrades:core": "npx hardhat test tests/upgrades/CoreFunctionality.test.js",
    "test:gas": "npx hardhat test tests/upgrades/GasOptimizedNFT.test.js --gas-report",

    "deploy:production": "node scripts/deployment/deploy-production.js deploy",
    "deploy:health": "node scripts/deployment/deploy-production.js health",
    "deploy:validate": "node scripts/deployment/deploy-production.js validate",
    "deploy:upgrades": "npx hardhat run scripts/deploy-upgrades.js --network localhost",
    "deploy:upgrades:testnet": "npx hardhat run scripts/deploy-upgrades.js --network sepolia",

    "health:check": "npm run db:health && npm run env:validate",
    "health:full": "npm run deploy:health",

    "logs:view": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log",
    "logs:clean": "node -e \"require('./src/lib/utils/logger').cleanup()\"",

    "security:audit": "npm audit && npm run test:security",
    "security:fix": "npm audit fix",
    "test:security": "jest tests/security/*.test.js"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@floating-ui/dom": "^1.7.1",
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.9",
    "@openzeppelin/contracts": "^5.3.0",
    "@preline/dropdown": "^3.1.0",
    "@preline/stepper": "^3.1.0",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@rainbow-me/rainbowkit": "2.2.7",
    "@reown/appkit": "^1.7.9",
    "@reown/appkit-adapter-wagmi": "^1.7.9",
    "@solana/pay": "^0.2.5",
    "@solana/web3.js": "^1.98.0",
    "@supabase/supabase-js": "^2.50.2",
    "@tanstack/react-query": "5.55.3",
    "animejs": "^4.0.2",
    "axios": "^1.8.3",
    "bignumber.js": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.0",
    "ethers": "^6.14.4",
    "form-data": "^4.0.0",
    "framer-motion": "^12.9.4",
    "gsap": "^3.13.0",
    "hardhat": "^2.24.0",
    "lenis": "^1.3.3",
    "lucide-react": "^0.479.0",
    "motion": "^12.9.4",
    "motion-plus": "^0.1.6",
    "next": "15.2.2",
    "nodemailer": "^7.0.3",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-textfit": "^1.1.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "shadcn": "2.5.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.31.3",
    "wagmi": "2.15.6",
    "zustand": "^5.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.8.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1"
  },
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6"
}
